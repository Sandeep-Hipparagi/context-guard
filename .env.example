# ==========================================
# Context Guard Upstream Routing Configuration
# ==========================================

# Upstream LLM Base URL (defaults to Groq)
OPENAI_BASE_URL="https://api.groq.com/openai/v1"
UPSTREAM_BASE_URL="https://api.groq.com/openai/v1"

# Upstream API Key (Groq gsk_...)
GROQ_API_KEY=""
UPSTREAM_API_KEY=""

# Default Model (e.g., llama-3.1-8b-instant, llama-3.3-70b-versatile)
DEFAULT_MODEL="llama-3.1-8b-instant"

# ==========================================
# Proxy Tuning & Policy
# ==========================================
CONTEXT_GUARD_HOST="0.0.0.0"
CONTEXT_GUARD_PORT=8080
PRESERVE_RECENT_TURNS=3
AUTO_COMPRESS_YELLOW=true
INTERVENTION_ON_RED=true
