# ==========================================
# Context Guard Upstream Routing Configuration
# ==========================================

# Upstream LLM Base URL (defaults to OpenRouter)
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
UPSTREAM_BASE_URL="https://openrouter.ai/api/v1"

# Upstream API Key (OpenRouter sk-or-v1-...)
OPENROUTER_API_KEY=""
UPSTREAM_API_KEY=""

# Optional OpenRouter headers for openrouter.ai app rankings
OPENROUTER_HTTP_REFERER="https://github.com/your-org/context-guard"
OPENROUTER_SITE_TITLE="Context Guard"

# ==========================================
# Proxy Tuning & Policy
# ==========================================
CONTEXT_GUARD_HOST="0.0.0.0"
CONTEXT_GUARD_PORT=8080
PRESERVE_RECENT_TURNS=3
AUTO_COMPRESS_YELLOW=true
INTERVENTION_ON_RED=true
